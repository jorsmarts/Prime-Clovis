# Prime Appliance Repair — Static Site
# Disable server-side caching, clean URLs, custom 404

# Turn off ETags
FileETag None

# No caching headers
<IfModule mod_headers.c>
  Header unset ETag
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</IfModule>

# Clean URLs — serve index.html for directory requests (already default)
DirectoryIndex index.html

# Custom 404
ErrorDocument 404 /404.html

# Remove .html extension (optional, future-proof)
Options -MultiViews
